# Track .log, .dat, .msg files - they contain useful simulation metadata
# (These are small and important for debugging)

# =============================================================================
# Data Directories - Selective Ignoring
# =============================================================================
# Keep .inp files (geometry definitions) - TRACKED
# Keep simulation files except .odb - TRACKED
# Keep processed .pt files (use Git LFS for >100MB) - TRACKED

# Ignore interim text files (regenerated from ODB)
data/interim/strains/*.txt

# Ignore large model checkpoints from training runs
results/*/training_*/best_models/*.pt
results/*/training_*/checkpoints/*.pt

